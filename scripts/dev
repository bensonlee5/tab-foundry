#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<'EOF'
Usage:
  ./scripts/dev bootstrap
  ./scripts/dev review-base [--base-ref <git-ref>]
  ./scripts/dev verify affected [--base-ref <git-ref>]
  ./scripts/dev verify paths <PATH...>
  ./scripts/dev verify audit
  ./scripts/dev verify full
  ./scripts/dev smoke iris [tab-foundry bench smoke iris args...]
EOF
}

ensure_venv() {
  if [[ ! -x "${REPO_ROOT}/.venv/bin/python" ]]; then
    echo "Missing ${REPO_ROOT}/.venv/bin/python. Run ./scripts/dev bootstrap first." >&2
    exit 1
  fi
}

primary_repo_root() {
  local common_git_dir
  common_git_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
  (cd "${common_git_dir}/.." && pwd)
}

pre_commit_python() {
  local primary_root
  primary_root="$(primary_repo_root)"
  if [[ -x "${primary_root}/.venv/bin/python" ]]; then
    printf '%s\n' "${primary_root}/.venv/bin/python"
    return
  fi
  printf '%s\n' "${REPO_ROOT}/.venv/bin/python"
}

rewrite_pre_commit_hook_python() {
  local common_git_dir hook_path install_python
  common_git_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
  hook_path="${common_git_dir}/hooks/pre-commit"
  install_python="$(pre_commit_python)"
  if [[ ! -f "${hook_path}" ]]; then
    return
  fi
  HOOK_PATH="${hook_path}" INSTALL_PYTHON_PATH="${install_python}" python3 - <<'PY'
from pathlib import Path
import os

hook_path = Path(os.environ["HOOK_PATH"])
install_python = os.environ["INSTALL_PYTHON_PATH"]
lines = hook_path.read_text(encoding="utf-8").splitlines()
rewritten = [
    f"INSTALL_PYTHON={install_python}" if line.startswith("INSTALL_PYTHON=") else line
    for line in lines
]
hook_path.write_text("\n".join(rewritten) + "\n", encoding="utf-8")
PY
}

main() {
  cd "${REPO_ROOT}"

  local command="${1:-}"
  case "${command}" in
    ""|help|-h|--help)
      usage
      ;;
    bootstrap)
      shift
      if [[ $# -ne 0 ]]; then
        usage >&2
        exit 1
      fi
      uv sync
      "$(pre_commit_python)" -m pre_commit install
      rewrite_pre_commit_hook_python
      ;;
    review-base|verify)
      ensure_venv
      exec ./.venv/bin/python scripts/audit/dev_verify.py "$@"
      ;;
    smoke)
      shift
      local smoke_command="${1:-}"
      case "${smoke_command}" in
        iris)
          shift
          ensure_venv
          exec ./.venv/bin/tab-foundry bench smoke iris "$@"
          ;;
        *)
          usage >&2
          exit 1
          ;;
      esac
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
